{
  "manifest_version": 3,
  "name": "MindShield: ADHD Reels & Shorts Blocker",
  "version": "1.0.2",
  "description": "Stop compulsive short-form video addiction. Blocks reels with brain-activating puzzles and cooldown timers.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://*.youtube.com/*",
    "https://*.facebook.com/*",
    "https://*.tiktok.com/*"
  ],
  "background": {
    "service_worker": "dist/background.bundle.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instagram.com/*",
        "https://*.youtube.com/*",
        "https://*.facebook.com/*",
        "https://*.tiktok.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file:///*"
      ],
      "js": ["dist/content.bundle.js"],
      "css": ["src/content/overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/overlay.css",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "MindShield ADHD Blocker",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
